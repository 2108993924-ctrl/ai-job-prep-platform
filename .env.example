# ============================================================
# 环境变量示例文件
# 使用方法：复制本文件为 .env，然后逐项填入你的真实配置
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ============================================================

# ---------- Supabase 数据库（必填）----------
# 在 Supabase 控制台 Project Settings -> API 中查看
# 形如：https://xxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# 服务端密钥（Service Role Key）：爬虫写库使用，权限最大，绝不要放到前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 匿名密钥（Anon Key）：前端只读查询使用，配合 RLS 策略
SUPABASE_ANON_KEY=your-anon-key

# ---------- LLM 配置（必填）----------
# 任选一种方式：
# 方式 A：OpenAI 官方
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# 方式 B：OpenAI 兼容接口（DeepSeek / 硅基流动 / 通义等均支持）
# 例如 DeepSeek：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- 爬虫行为（可选，有默认值）----------
# 爬虫 User-Agent 中公布的联系方式（用于合规声明，必填）
CONTACT_EMAIL=your-email@example.com
# 单域名每日抓取上限（合规约束，默认 200）
DAILY_MAX_JOBS_PER_DOMAIN=200
# 单次请求间隔下限（秒，默认 3，代码会在 3~5 秒间随机）
CRAWL_INTERVAL_MIN=3
CRAWL_INTERVAL_MAX=5

# ---------- 告警（可选）----------
# 爬取失败时通过 Webhook 通知，二选一，不填则仅记录日志
# 飞书自定义机器人：https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_WEBHOOK=
# Slack Incoming Webhook：https://hooks.slack.com/services/xxx
SLACK_WEBHOOK=
